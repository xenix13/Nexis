{
  "name": "nexis-desktop",
  "productName": "Noxa",
  "version": "1.2.1",
  "description": "Noxa pour Windows, macOS et Linux : l'interface de votre serveur Noxa, dans une vraie application.",
  "homepage": "https://github.com/xenix13/Noxa",
  "author": {
    "name": "Noxa",
    "email": "noxa@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "desktopName": "nexis.desktop",
  "scripts": {
    "start": "electron .",
    "icon": "node -e \"const fs=require('fs');fs.mkdirSync('build',{recursive:true});fs.copyFileSync('../../static/icons/icon-512.png','build/icon.png')\"",
    "dist": "npm run icon && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "fr.nexis.desktop",
    "productName": "Noxa",
    "copyright": "Noxa",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "strings.js",
      "package.json",
      "build/icon.png"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://localhost/apps/desktop"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Noxa-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Noxa"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "identity": "-",
      "artifactName": "Noxa-mac.${ext}",
      "icon": "assets/icon-mac.png"
    },
    "dmg": {
      "artifactName": "Noxa.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "maintainer": "Noxa <noxa@users.noreply.github.com>",
      "synopsis": "Noxa : films, séries et TV de votre serveur",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Noxa.AppImage"
    },
    "deb": {
      "artifactName": "noxa-desktop.deb"
    }
  }
}
